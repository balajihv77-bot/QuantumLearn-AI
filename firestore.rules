rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default-deny all unmapped operations
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Security Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation helpers
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 255 &&
             data.displayName is string && data.displayName.size() <= 128;
    }

    function isValidCircuit(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 128 &&
             data.numQubits is number && data.numQubits >= 1 && data.numQubits <= 10 &&
             data.numSteps is number && data.numSteps >= 1 && data.numSteps <= 50;
    }

    function isValidInterviewSession(data) {
      return data.sessionId is string && isValidId(data.sessionId) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.role is string && data.role.size() <= 100 &&
             data.difficulty is string && data.difficulty.size() <= 50 &&
             data.status is string && data.status.size() <= 50;
    }

    function isValidInterviewReport(data) {
      return data.id is string && isValidId(data.id) &&
             data.sessionId is string && isValidId(data.sessionId) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.overallScore is number && data.overallScore >= 0 && data.overallScore <= 100;
    }

    // --- Users Collection (PII Isolated, Owner Access Only) ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Block user enumeration to protect student PII
      allow create: if isOwner(userId) && incoming().uid == request.auth.uid && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && incoming().uid == request.auth.uid && isValidUserProfile(incoming());
      allow delete: if false;
    }

    // --- Quantum Circuits Collection ---
    match /circuits/{circuitId} {
      allow get: if isValidId(circuitId) && (existing().isPublic == true || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isValidId(circuitId) && isSignedIn() && incoming().userId == request.auth.uid && isValidCircuit(incoming());
      allow update: if isValidId(circuitId) && isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidCircuit(incoming());
      allow delete: if isValidId(circuitId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // --- Mock Interview Sessions Collection ---
    match /interviewSessions/{sessionId} {
      allow get: if isValidId(sessionId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isValidId(sessionId) && isSignedIn() && incoming().userId == request.auth.uid && isValidInterviewSession(incoming());
      allow update: if isValidId(sessionId) && isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidInterviewSession(incoming());
      allow delete: if isValidId(sessionId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    // --- Mock Interview Reports Collection (Immutable Evaluations) ---
    match /interviewReports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isValidId(reportId) && isSignedIn() && incoming().userId == request.auth.uid && isValidInterviewReport(incoming());
      allow update, delete: if false; // Evaluations are immutable records
    }
  }
}
